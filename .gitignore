# -----------------------------
# Secrets / environment files
# -----------------------------

.env
.env.*
*.env

**/.env
**/.env.*
**/*.env


# -----------------------------
# Dependencies
# -----------------------------

node_modules/
**/node_modules/


# -----------------------------
# Build output
# -----------------------------

dist/
**/dist/


# -----------------------------
# Local BuzzBoard save data
# -----------------------------

server/data/


# -----------------------------
# Cloud migration backups
# -----------------------------

cloud-games-*.json


# -----------------------------
# Development backups / temp files
# -----------------------------

*.before-*
**/*.before-*

*.new
**/*.new

*.bak
**/*.bak

*.backup
**/*.backup


# -----------------------------
# Railway local metadata
# -----------------------------

.railway/


# -----------------------------
# Editor files
# -----------------------------

.vscode/
.idea/


# -----------------------------
# Logs
# -----------------------------

*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# -----------------------------
# Operating system clutter
# -----------------------------

.DS_Store
Thumbs.db
desktop.ini